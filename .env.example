# Dexibo configuration — copy to .env and adjust

# Branding
DEXIBO_NAME=Dexibo
DEXIBO_TAGLINE=lite fintech intelligence

# Model: path to a GGUF file (relative to project root or absolute)
# Recommended: Qwen2.5-3B-Instruct Q4_K_M (~2.0 GB) or Phi-3-mini Q4 (~2.4 GB)
DEXIBO_MODEL_PATH=models/Qwen2.5-3B-Instruct-Q4_K_M.gguf

# Inference (CPU-friendly defaults for ~4GB systems)
DEXIBO_N_CTX=4096
DEXIBO_N_GPU_LAYERS=0
DEXIBO_N_THREADS=
DEXIBO_MAX_TOKENS=512
DEXIBO_TEMPERATURE=0.7
DEXIBO_TOP_P=0.9
DEXIBO_REPEAT_PENALTY=1.1

# Force mock mode even if a model file exists (1/true/yes)
DEXIBO_FORCE_MOCK=0

# Default currency framing for examples (ISO 4217)
DEXIBO_DEFAULT_CURRENCY=GBP

# --- v0.2 upgrades (all default on) ---
# Fintech RAG (TF-IDF over knowledge/ + concepts)
DEXIBO_RAG=1
DEXIBO_RAG_TOP_K=3

# Compliance / advice guardrails
DEXIBO_GUARDRAILS=1

# Delayed unofficial quotes via Yahoo Finance (stdlib urllib)
DEXIBO_QUOTES=1

# --- v0.3 web UI ---
DEXIBO_WEB_HOST=127.0.0.1
DEXIBO_WEB_PORT=8787
